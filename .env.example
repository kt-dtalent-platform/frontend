# 백엔드 API 경로. 백엔드 주소 규칙(/v1/...)을 그대로 따른다.
VITE_API_BASE_URL=/v1

# 개발 서버는 기본으로 MSW 목업 응답을 쓴다. 로컬 백엔드와 붙일 때만 false.
VITE_USE_MOCK=true

# 목업을 끄면 개발 서버가 /v1 요청을 이 주소의 백엔드로 넘긴다(프록시). 그래서 CORS 설정이 필요 없다.
VITE_BACKEND_ORIGIN=http://localhost:8080

# 목업을 켠 채로 일부 API만 실제 서버로 보낸다. 쉼표로 묶음 이름을 적는다. 비우면 전부 목업.
# 묶음: auth(로그인, 내 정보, 비밀번호), scholars(장학생, 기수), tasks(장학생 할 일과 제출), requests(요청, 대시보드, 제출 현황), review(개별 검토), all
# 예: VITE_LIVE_API=auth,scholars
VITE_LIVE_API=
